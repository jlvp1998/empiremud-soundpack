   match="^\*\* The colossus starts waving its arm in the air in an attempt to shake you off\! \*\* \(cling\)$"
   regexp="y"
   sequence="100"
  >
  <send>cling</send>
  </trigger>
  <trigger
   enabled="y"
   match="^\*\* The headless centaur (.*?)\! \*\* \(dodge\)"
   regexp="y"
   send_to="12"
   sequence="100"
  >
  <send>Execute("dodge")</send>
  </trigger>
  <trigger
   enabled="y"
   match="^\[\/([A-Za-z0-9]*?)\] (.*?)$"
   regexp="y"
   send_to="12"
   sequence="100"
  >
  <send>ppi.play(GetInfo("56").."/worlds/empire/general/%1.ogg",0,0,Gv)
Execute("history_add all=%0")
Execute("history_add %1=%0")</send>
  </trigger>
  <trigger
   enabled="y"
   match="you have a moment to stop and rest -- but not too long; the colossus is *"
   omit_from_log="y"
   omit_from_output="y"
   send_to="14"
   sequence="100"
  >
  <send>print("you have a moment to stop and rest -- but not too long. The colossus is %1")</send>
  </trigger>
</triggers>

